# --- Core ---
ENV=production
APP_NAME=IG Funnel
SECRET_KEY=change-this-to-a-long-random-string
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
APP_BASE_URL=http://localhost:8000

# --- Database ---
# Values below are for LOCAL runs. Inside docker compose the container paths
# must be absolute (/data/..., MEDIA_ROOT=/data/media) — the live server .env
# already does this; do not copy these relative paths into a container deploy.
# Async URL (FastAPI): sqlite+aiosqlite:///./data/app.db
# Sync URL (Celery workers â€” sync SQLAlchemy engine, no event loop):
#   sqlite:///./data/app.db
# PostgreSQL (enable `postgres` profile):
#   async: postgresql+asyncpg://igfunnel:changeme@postgres:5432/igfunnel
#   sync:  postgresql+psycopg2://igfunnel:changeme@postgres:5432/igfunnel
# If SYNC_DATABASE_URL is left at its default while DATABASE_URL is customized,
# the backend derives the sync URL automatically (+aiosqlite -> plain, +asyncpg -> +psycopg2).
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
SYNC_DATABASE_URL=sqlite:///./data/app.db
POSTGRES_USER=igfunnel
POSTGRES_PASSWORD=changeme
POSTGRES_DB=igfunnel

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Admin auth (single admin, credentials live here â€” never in the DB) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-please
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Media / uploads ---
MEDIA_ROOT=./media
MAX_UPLOAD_MB=500
AUTO_PROCESS_ON_UPLOAD=true

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# CIDR of the compose proxy network. Uvicorn trusts ONLY this range for
# X-Forwarded-* headers (never '*': with '*' uvicorn takes the leftmost,
# client-controlled XFF entry, letting anyone spoof their IP past rate
# limits). It also sets the docker bridge subnet, so one override keeps
# both in agreement. Change it only if 172.28.0.0/16 collides with your
# LAN/VPN.
TRUSTED_PROXY_CIDR=172.28.0.0/16

# Set to 'true' to enable /docs, /redoc and /openapi.json (dev only).
DOCS_ENABLED=false

# Timezone whose wall-clock the schedule-rule hours follow (IANA name,
# e.g. Asia/Tehran, Europe/Berlin). A rule set for "Sat 12:00" fires at
# 12:00 in THIS zone — set it to your own so dashboard times match reality.
SCHEDULE_TZ=UTC

# Grace window (minutes) a schedule-rule slot stays fireable AFTER its
# minute passes. If the worker/beat is down at the exact scheduled minute,
# the next tick still posts the slot (a few minutes late) instead of
# silently losing it. 0 = legacy exact-minute behavior.
SCHEDULE_GRACE_MINUTES=5

# --- Frontend-only (compose/build inputs — NOT read by the backend) ---
# Leave empty for the default nginx same-origin deploy. Set to
# http://<host>:8000 only when exposing the frontend container directly.
FRONTEND_API_URL=
NGINX_PORT=8080
# Rendered into the nginx config (see docker-compose.yml). Must stay above
# the backend's MAX_UPLOAD_MB — nginx 413s anything larger, which silently
# breaks all uploads if MAX_UPLOAD_MB is raised past this value.
CLIENT_MAX_BODY_SIZE=550m

# --- Instagram defaults ---
IG_DEFAULT_MAX_DAILY_POSTS=3
IG_PRE_POST_DELAY_MIN=30
IG_PRE_POST_DELAY_MAX=120

events {}
http {
  # Docker embedded DNS. Upstream hostnames below go through a variable on
  # purpose: plain `upstream { server name; }` blocks resolve the name ONCE
  # at (re)load, so a recreated backend container (new IP) gets Connection
  # refused until nginx restarts. Variables re-resolve per-request (10s TTL).
  resolver 127.0.0.11 valid=10s;

  server_tokens off;

  # Compress proxied text assets (Next.js static chunks, JSON API).
  # gzip_proxied is required: by default nginx never gzips proxy_pass
  # responses.
  gzip on;
  gzip_proxied any;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml;

  server {
    listen 80;
    set $backend_upstream backend:8000;
    set $frontend_upstream frontend:3000;

    # Security headers (no location below sets add_header, so these apply
    # everywhere).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Rendered from the environment by the image entrypoint
    # (NGINX_ENVSUBST_FILTER=CLIENT_MAX_BODY_SIZE). Must stay above the
    # backend's MAX_UPLOAD_MB — nginx 413s anything larger, which would
    # silently break uploads if MAX_UPLOAD_MB were raised past this.
    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    # API + websocket
    # IG-facing calls run up to 180s server-side: nginx's default 60s
    # proxy_read_timeout used to 504 them with an HTML page (no JSON detail
    # → the UI could only show a bare "failed"). Timeouts match the app tier.
    location /api/ {
      proxy_pass http://$backend_upstream;
      proxy_set_header Host $host;
      # Forwarded headers are required: slowapi rate-limits by client IP, and
      # without X-Forwarded-For every client looks like the nginx container
      # (one shared login bucket). The backend runs uvicorn --proxy-headers
      # (see docker-compose) so request.client.host is the real client IP.
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_connect_timeout 30s;
      proxy_send_timeout 300s;
      proxy_read_timeout 300s;
    }
    location /ws {
      proxy_pass http://$backend_upstream;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      # Realtime feed idles between events — the default 60s read timeout
      # would drop quiet connections and force reconnect churn.
      proxy_connect_timeout 30s;
      proxy_send_timeout 60s;
      proxy_read_timeout 86400s;
    }
    location /health {
      proxy_pass http://$backend_upstream;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # FastAPI self-docs (not under /api/).
    location = /docs { proxy_pass http://$backend_upstream; proxy_set_header Host $host; }
    location = /redoc { proxy_pass http://$backend_upstream; proxy_set_header Host $host; }
    location = /openapi.json { proxy_pass http://$backend_upstream; proxy_set_header Host $host; }

    # No direct media access: previews/thumbnails are served by the API
    # behind admin auth (/api/v1/videos/...). A public alias here would
    # bypass that and expose raw uploads, sessions-adjacent files included.

    # Everything else → Next.js
    location / { proxy_pass http://$frontend_upstream; proxy_set_header Host $host; }
  }
}
